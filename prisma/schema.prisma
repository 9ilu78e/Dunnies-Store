generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(cuid())
  fullName               String
  email                  String   @unique
  phone                  String?
  password               String
  role                   String   @default("user")
  dateOfBirth            DateTime?
  gender                 String?
  notificationPreferences Json    @default("{\"orderUpdates\":true,\"promotions\":true,\"newsletter\":false,\"smsNotifications\":true}")
  language               String   @default("English")
  currency               String   @default("NGN")
  timeZone               String   @default("WAT")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  orders         Order[]
  addresses      Address[]
  paymentMethods SavedPaymentMethod[]
  comments       ProductComment[]
  likes          ProductLike[]
  commentReplies CommentReply[]   @relation("CommentReplies")
  commentLikes   CommentLike[]
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String
  recipient   String
  phone       String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  country     String   @default("Nigeria")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  type        String   @default("product") // "product", "gift", "souvenir"
  priority    String   @default("normal") // "popular", "trending", "new", "normal"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  gifts     Gift[]     @relation("GiftCategory")
  souvenirs Souvenir[] @relation("SouvenirCategory")

  @@unique([name, type])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  description     String
  price           Float
  deliveryFee     Float     @default(0)
  stockQuantity   Int       @default(0)
  sizeVariants    Json      @default("[]")
  imageUrl        String?
  imageUrls       String[]  @default([])
  categoryId      String?
  priority        String    @default("normal") // "bestseller", "featured", "trending", "new", "normal"
  flashSalePrice  Float?
  flashSaleEndsAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category      Category?             @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  comments      ProductComment[]
  likes         ProductLike[]
  firebaseLikes FirebaseProductLike[]
}

model Gift {
  id              String    @id @default(cuid())
  name            String
  description     String?
  price           Float
  deliveryFee     Float     @default(0)
  stockQuantity   Int       @default(0)
  sizeVariants    Json      @default("[]")
  imageUrl        String?
  imageUrls       String[]  @default([])
  includedProducts Json     @default("[]")
  extraPrice       Float    @default(0)
  categoryId      String?
  priority        String    @default("normal")
  flashSalePrice  Float?
  flashSaleEndsAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category   Category?   @relation("GiftCategory", fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Souvenir {
  id              String    @id @default(cuid())
  name            String
  description     String?
  price           Float
  deliveryFee     Float     @default(0)
  stockQuantity   Int       @default(0)
  sizeVariants    Json      @default("[]")
  imageUrl        String?
  imageUrls       String[]  @default([])
  categoryId      String?
  priority        String    @default("normal")
  flashSalePrice  Float?
  flashSaleEndsAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category   Category?   @relation("SouvenirCategory", fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     Int      @unique @default(autoincrement())
  userId          String?
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String   @default("")
  paymentMethod   String   @default("pay-on-delivery")
  paymentStatus   String   @default("pending")
  total           Float
  deliveryFee     Float?
  status          String   @default("pending") // "pending", "confirmed", "processing", "delivered", "cancelled"
  archivedAt      DateTime?
  source          String   @default("site") // "site", "whatsapp", "other"
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  payment    PaystackPayment?
}

model PaystackPayment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  provider          String    @default("paystack")
  reference         String    @unique
  transactionId     String?
  amountKobo        Int
  currency          String    @default("NGN")
  status            String    @default("pending")
  authorizationUrl  String?
  savePaymentMethod Boolean   @default(false)
  savedMethodChargeAttemptedAt DateTime?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model SavedPaymentMethod {
  id                       String   @id @default(cuid())
  userId                   String
  authorizationCodeEncrypted String
  signature                String
  brand                    String?
  cardType                 String?
  last4                    String
  expMonth                 String
  expYear                  String
  bank                     String?
  isDefault                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, signature])
  @@index([userId, isDefault])
}

model Notification {
  id            String   @id @default(cuid())
  recipientRole String   @default("user") // "user" or "admin"
  accountId     String
  orderId       String?
  title         String
  message       String
  link          String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([recipientRole, accountId, isRead])
  @@index([orderId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isSubscribed   Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isSubscribed])
}

model SiteSettings {
  id                  String   @id @default("main")
  storeName           String   @default("Dunnis Stores")
  headerSubtitle      String   @default("Premium Shopping")
  headerLogo          String   @default("")
  headerTitleColor    String   @default("#7c3aed")
  headerSubtitleColor String   @default("#6b7280")
  supportEmail        String   @default("support@dunnistores.ng")
  supportPhone        String   @default("+234 901 987 6543")
  address             String   @default("Garki, Abuja, Nigeria")
  heroImages          String[] @default([])
  heroSlides          Json     @default("[]")
  updatedAt           DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isReviewed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isReviewed, createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  status    String   @default("sent") // "sent", "failed"
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLoginToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  giftId     String?
  souvenirId String?
  quantity   Int
  unitPrice  Float?
  size       String?
  giftContents Json?

  order    Order     @relation(fields: [orderId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])
  gift     Gift?     @relation(fields: [giftId], references: [id])
  souvenir Souvenir? @relation(fields: [souvenirId], references: [id])
}

model ProductComment {
  id              String   @id @default(cuid())
  productId       String
  userId          String?
  firebaseUserUid String?
  text            String
  rating          Int      @default(5) // 1-5 stars
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firebaseUser FirebaseUser?  @relation("FirebaseProductComments", fields: [firebaseUserUid], references: [uid], onDelete: Cascade)
  replies      CommentReply[]
  likes        CommentLike[]

  @@index([productId])
  @@index([userId])
  @@index([firebaseUserUid])
}

model CommentReply {
  id              String   @id @default(cuid())
  commentId       String
  userId          String?
  firebaseUserUid String?
  text            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comment      ProductComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User?          @relation("CommentReplies", fields: [userId], references: [id], onDelete: Cascade)
  firebaseUser FirebaseUser?  @relation("FirebaseCommentReplies", fields: [firebaseUserUid], references: [uid], onDelete: Cascade)
  likes        CommentLike[]

  @@index([commentId])
  @@index([userId])
  @@index([firebaseUserUid])
}

model CommentLike {
  id              String   @id @default(cuid())
  userId          String?
  firebaseUserUid String?
  commentId       String?
  replyId         String?
  createdAt       DateTime @default(now())

  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firebaseUser FirebaseUser?   @relation("FirebaseCommentLikes", fields: [firebaseUserUid], references: [uid], onDelete: Cascade)
  comment      ProductComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reply        CommentReply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId, replyId])
  @@unique([firebaseUserUid, commentId])
  @@unique([firebaseUserUid, replyId])
  @@index([userId])
  @@index([firebaseUserUid])
  @@index([commentId])
  @@index([replyId])
}

model ProductLike {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

model FirebaseUser {
  id           String                @id @default(cuid())
  uid          String                @unique @default(cuid())
  email        String                @unique
  name         String
  photo        String?
  provider     String                @default("firebase")
  role         String                @default("user")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  productLikes FirebaseProductLike[]
  comments     ProductComment[]      @relation("FirebaseProductComments")
  replies      CommentReply[]        @relation("FirebaseCommentReplies")
  commentLikes CommentLike[]         @relation("FirebaseCommentLikes")
}

model LiveChatConversation {
  id               String            @id @default(cuid())
  userAccountSource String
  userAccountId    String
  userName         String
  userEmail        String
  status           String            @default("open")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         LiveChatMessage[]

  @@index([userAccountSource, userAccountId, status, updatedAt])
  @@index([status, updatedAt])
}

model LiveChatMessage {
  id              String               @id @default(cuid())
  conversationId  String
  senderAccountId String
  senderRole      String
  senderName      String
  body            String
  createdAt       DateTime             @default(now())
  conversation    LiveChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model FirebaseProductLike {
  id        String   @id @default(cuid())
  productId String
  userUid   String
  createdAt DateTime @default(now())

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    FirebaseUser @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@unique([productId, userUid])
  @@index([productId])
  @@index([userUid])
}
